{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteAssist",
  "version": "0.2.0",
  "identifier": "com.remoteassist.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteAssist",
        "width": 1100,
        "height": 760,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": null
      }
    }
  }
}
