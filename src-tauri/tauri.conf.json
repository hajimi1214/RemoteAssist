{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteAssist",
  "version": "0.8.0-alpha",
  "identifier": "com.remoteassist.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoteAssist",
        "width": 1100,
        "height": 700,
        "minWidth": 320,
        "minHeight": 480,
        "visible": true,
        "maximized": true,
        "decorations": false,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http://localhost:8080 ws://localhost:8080 https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": null
      }
    }
  }
}
