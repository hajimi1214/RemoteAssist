REMOTEASSIST_VERSION=local
PUBLIC_DOMAIN=remoteassist.example.com
PUBLIC_BASE_URL=https://remoteassist.example.com
SESSION_CODE_TTL=5m
WS_MAX_MESSAGE_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
LOGIN_FAIL_LIMIT_PER_MINUTE=10
TRUSTED_PROXY_CIDRS=172.16.0.0/12
APP_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
LOG_LEVEL=info

POSTGRES_DB=remoteassist
POSTGRES_USER=remoteassist
POSTGRES_PASSWORD=replace-with-random-postgres-password
DATABASE_URL=postgres://remoteassist:replace-with-random-postgres-password@postgres:5432/remoteassist?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-more-random-characters

TURN_REALM=remoteassist.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_MIN_PORT=49152
TURN_MAX_PORT=49200
TURN_URLS=turn:remoteassist.example.com:3478?transport=udp,turn:remoteassist.example.com:3478?transport=tcp
TURN_SECRET=replace-with-random-turn-shared-secret
TURN_CREDENTIAL_TTL=10m
